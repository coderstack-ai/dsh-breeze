{
  "name": "dsh-breeze",
  "version": "0.1.0",
  "description": "Breeze TTS 2 for DeepSeek Harness — model-facing tools plus one settings section: synthesis, voice design/cloning, voice library. / 给 DSH 的 Breeze TTS 2：模型可调用的工具 + 一个独立设置分区（合成、语音设计/克隆、音色库）。",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib/",
    "README.md",
    "README-AI.md",
    "NOTICE.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "tts",
    "breeze",
    "voice",
    "speech",
    "text-to-speech",
    "voice-clone",
    "tool"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coderstack-ai/dsh-breeze.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@electron/asar": "^3.2.10"
  }
}
